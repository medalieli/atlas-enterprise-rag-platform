# Application
APP_ENV=development
APP_NAME=Production RAG Assistant
API_PORT=8000

# PostgreSQL (local development placeholders only)
POSTGRES_PORT=5432
POSTGRES_DB=rag_assistant_dev
POSTGRES_USER=rag_assistant_dev
POSTGRES_PASSWORD=rag_assistant_dev
DATABASE_URL=postgresql+asyncpg://rag_assistant_dev:rag_assistant_dev@postgres:5432/rag_assistant_dev

# Optional; milestone 2 does not call OpenAI
OPENAI_API_KEY=

# Milestone 4 ingestion (20 MiB upload, 100 MiB expanded DOCX ceiling)
MAX_UPLOAD_BYTES=20971520
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
CELERY_MAX_RETRIES=3

# Explicit development-only identity; leave empty unless using the local seed.
DEVELOPMENT_TENANT_ID=
DEVELOPMENT_USER_ID=
