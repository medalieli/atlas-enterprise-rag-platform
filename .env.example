# Application
APP_ENV=development
APP_NAME=Production RAG Assistant
API_PORT=8000
FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:3000

# Milestone 13 BFF/OIDC. SESSION_SECRET and OIDC_CLIENT_SECRET are secrets and
# must be supplied from secret management outside local development.
SESSION_SECRET=development-session-secret-change-me
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_CLIENT_ID=production-rag-assistant-web
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile offline_access rag:access

# PostgreSQL (local development placeholders only)
POSTGRES_PORT=5432
POSTGRES_DB=rag_assistant_dev
POSTGRES_USER=rag_assistant_dev
POSTGRES_PASSWORD=rag_assistant_dev
DATABASE_URL=postgresql+asyncpg://rag_assistant_dev:rag_assistant_dev@postgres:5432/rag_assistant_dev

# Milestone 6 embeddings. Safe placeholder; application starts without a key.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER_MAX_RETRIES=0
EMBEDDING_MAX_INPUT_TOKENS=8191
EMBEDDING_MAX_BATCH_TOKENS=300000

# Milestone 8 local reranker. The Docker image pins and validates this exact revision.
RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_PROVIDER=local
RERANKER_MODEL_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RERANKER_MODEL_PATH=/models/reranker
RERANKER_CANDIDATE_LIMIT=30
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_CONCURRENCY=2

# Milestone 9 grounded generation. Responses are not stored by the application API.
ANSWER_MODEL=gpt-5.6-terra
ANSWER_REASONING_EFFORT=low
ANSWER_VERBOSITY=medium
ANSWER_MAX_CONTEXT_CHUNKS=8
ANSWER_MAX_CONTEXT_TOKENS=12000
ANSWER_MAX_CONTEXT_CHARS=48000
ANSWER_MAX_OUTPUT_TOKENS=2000
ANSWER_PROVIDER_TIMEOUT_SECONDS=45
ANSWER_PROVIDER_MAX_RETRIES=1
ANSWER_MAX_CONCURRENCY=2
ANSWER_MAX_CLAIMS=12
ANSWER_MAX_CITATIONS_PER_CLAIM=5

# Milestone 11 application-managed conversations and follow-up rewriting.
REWRITE_MODEL=gpt-5.6-luna
REWRITE_REASONING_EFFORT=low
REWRITE_MAX_OUTPUT_TOKENS=600
REWRITE_PROVIDER_TIMEOUT_SECONDS=30
REWRITE_PROVIDER_MAX_RETRIES=1
REWRITE_MAX_CONCURRENCY=2
CONVERSATION_HISTORY_MAX_TURNS=6
CONVERSATION_HISTORY_MAX_MESSAGES=12
CONVERSATION_HISTORY_MAX_TOKENS=4000
CONVERSATION_HISTORY_MAX_CHARS=16000

# Milestone 4 ingestion (20 MiB upload, 100 MiB expanded DOCX ceiling)
MAX_UPLOAD_BYTES=20971520
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
CELERY_MAX_RETRIES=3

# Milestone 5 deterministic parsing/chunking limits
PARSER_MAX_PDF_PAGES=500
PARSER_MAX_EXTRACTED_CHARS=5000000
PARSER_MAX_PDF_STREAM_BYTES=52428800
PARSER_SOFT_TIME_LIMIT_SECONDS=120
PARSER_HARD_TIME_LIMIT_SECONDS=150
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=150

# Explicit development-only identity; leave empty unless using the local seed.
DEVELOPMENT_TENANT_ID=
DEVELOPMENT_USER_ID=

# Milestone 10 external OAuth/OIDC access-token validation. HTTP is local-test only.
AUTH_ENABLED=false
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=production-rag-assistant-api
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ALLOWED_ALGORITHM=RS256
AUTH_EXPECTED_TOKEN_TYPE=at+jwt
AUTH_REQUIRED_SCOPES=rag:access
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_MAX_TOKEN_BYTES=8192
AUTH_MAX_TOKEN_AGE_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=3
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_MAX_BYTES=65536
AUTH_ALLOW_INSECURE_HTTP=false
