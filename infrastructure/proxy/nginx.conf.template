worker_processes auto;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server_tokens off;
  access_log /dev/stdout combined;
  error_log /dev/stderr warn;
  limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
  limit_req_zone $binary_remote_addr zone=upload:10m rate=10r/m;
  limit_req_zone $binary_remote_addr zone=search:10m rate=60r/m;
  limit_conn_zone $binary_remote_addr zone=expensive:10m;
  client_body_timeout 15s;
  client_max_body_size 21m;
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 180s;
  proxy_hide_header X-Powered-By;
  limit_req_status 429;

  server {
    listen 8080;
    if ($host != "${PRODUCTION_HOSTNAME}") { return 421; }
    return 308 https://$host$request_uri;
  }
  server {
    listen 8443 ssl;
    if ($host != "${PRODUCTION_HOSTNAME}") { return 421; }
    ssl_certificate /run/tls/tls.crt;
    ssl_certificate_key /run/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;

    location ~ ^/api/auth/(login|callback) { limit_req zone=auth burst=3 nodelay; proxy_pass http://frontend:3000; include /etc/nginx/proxy_params; }
    location ~ ^/api/backend/.*/documents($|/) { limit_req zone=upload burst=5 nodelay; limit_conn expensive 2; proxy_pass http://frontend:3000; include /etc/nginx/proxy_params; }
    location ~ ^/api/backend/.*/(search|ask|conversations) { limit_req zone=search burst=10 nodelay; limit_conn expensive 4; proxy_pass http://frontend:3000; include /etc/nginx/proxy_params; }
    location / { proxy_pass http://frontend:3000; include /etc/nginx/proxy_params; }
  }
}
